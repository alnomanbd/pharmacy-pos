# Dawai Data API — copy to .env for local runs.
PORT=5200
# The same database the platform writes; give this service a user that can
# only READ medicines, medicinegenerics, medicinecompanies, medicinedemanddailies,
# medicinecoverages and medicinedemandruns, and read/write its own data_* collections.
MONGODB_URI=mongodb://localhost:27017/dawai
# The admin page's password. At least 32 characters; long and random.
DATA_API_ADMIN_TOKEN=
# Fewest different shops behind any figure that leaves. Never below 5 in production.
DEMAND_MIN_SHOPS=5
# Set to 1 behind a proxy (nginx, a load balancer) so client addresses are right.
TRUST_PROXY=
