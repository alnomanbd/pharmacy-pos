{
  "name": "@dawai/api",
  "version": "0.1.0",
  "description": "Dawai — API (Express + MongoDB)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:all": "tsx src/seed/run.ts all",
    "seed:plans": "tsx src/seed/run.ts plans",
    "seed:platform-admin": "tsx src/seed/run.ts platform-admin",
    "catalog:restore": "tsx src/seed/run.ts catalog:restore",
    "catalog:export": "tsx src/seed/run.ts catalog:export",
    "seed:catalog:copy": "tsx src/seed/run.ts catalog:copy",
    "seed:medicines:full": "tsx src/seed/run.ts medicines:full",
    "seed:companies": "tsx src/seed/run.ts companies",
    "seed:demo-shop": "tsx src/seed/run.ts demo-shop",
    "seed:shop-demo": "tsx src/seed/run.ts shop-demo",
    "catalog:build": "tsx src/seed/run.ts catalog:build",
    "mail:test": "tsx src/scripts/mailTest.ts",
    "sms:test": "tsx src/scripts/smsTest.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "bwip-js": "^4.11.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dawai": "file:../..",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.12",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
