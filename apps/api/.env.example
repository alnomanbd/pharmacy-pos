# Dawai API — copy to .env and fill in.
NODE_ENV=development
PORT=5100
# Its own database. Moving it to another server is a URI change.
MONGODB_URI=mongodb://localhost:27017/dawai
# The three browser origins: the shop app, the operator console, the marketing site.
CLIENT_URL=http://localhost:5175
CONSOLE_URL=http://localhost:5176
SITE_URL=http://localhost:3100
# Behind nginx / a load balancer set this to 1, or every rate limit is shared.
TRUST_PROXY=
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters
# Mail (sign-up, approval, password reset, payment receipts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dawai <no-reply@dawai.com.bd>"
# SMS for customer baki reminders: log | twilio | bulksms
SMS_PROVIDER=log
# Where shops send subscription money (shown on the billing page)
PAY_BKASH=
PAY_NAGAD=
PAY_UPAY=
PAY_ROCKET=
PAY_BANK=
# The invoice header
INVOICE_ISSUER=Dawai
INVOICE_ADDRESS=
INVOICE_PHONE=
INVOICE_EMAIL=
INVOICE_BIN=
# Must every console operator use two-factor? Keep true in production: an
# operator can suspend, export and delete every shop. false makes it optional,
# turned on and off from the console's Security page.
OPERATOR_2FA_REQUIRED=true
# The operator login created by `npm run seed:platform-admin`
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Demo shop logins created by `npm run seed:demo-shop`
SEED_SHOP_PASSWORD=Shop@1234

# The console's System page shows when the last backup finished. The nightly
# backup touches this file once the dump succeeds; leave empty if backups are
# not reported. See docs/OPERATIONS.md.
BACKUP_MARKER_FILE=
# The folder the backup service writes to, for the Backups card on System.
# Set by docker-compose; leave empty in development.
BACKUP_DIR=

# VAT inside the plan price on Dawai's invoices to shops, in percent (0 = none).
# Invoices say "TAX INVOICE" only when INVOICE_BIN is set too.
INVOICE_VAT_PERCENT=15

# Online payment through SSLCommerz (bKash, Nagad, Rocket, Upay, cards, banks).
# Leave the store id empty and the shop app offers only "send it yourself".
# SSLCZ_SANDBOX=true uses the test gateway; set false for real money.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true
# Where SSLCommerz posts back. Defaults to CLIENT_URL + /api, which works when
# the shop app's host forwards /api to this API. Must be reachable from the
# internet for the IPN, so it cannot be localhost in production.
SSLCZ_CALLBACK_BASE=

# The 7/3/1-day renewal reminders go by SMS to the owner as well as by email.
# Set to off to send email only.
REMINDER_SMS=on

# Phone alerts (Web Push). Leave empty and a key pair is made on first use and
# kept, encrypted, in the database. Set both to pin them across databases:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alnoman.cse@outlook.com

# Where bKash sends the customer back after an automatic payment at the till.
# Defaults to SSLCZ_CALLBACK_BASE, then CLIENT_URL + /api.
BKASH_CALLBACK_BASE=
# Seals shop secrets at rest (bKash merchant keys, the VAPID pair). Defaults to
# a key derived from JWT_ACCESS_SECRET; set it before going live and keep it.
DATA_ENCRYPTION_KEY=
