# docker compose reads this file. Copy it to .env and fill it in.
# For local development without Docker, use apps/api/.env.example instead.

# Public addresses, as the browser sees them.
SHOP_URL=https://shop.dawai.com.bd
CONSOLE_URL=https://console.dawai.com.bd
SITE_URL=https://dawai.com.bd
PUBLIC_API_URL=https://shop.dawai.com.bd/api

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Mail: sign-up, approval, password reset, payment receipts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dawai <no-reply@dawai.com.bd>"

# SMS for baki reminders: log | twilio | bulksms
SMS_PROVIDER=log

# Where shops send subscription money, shown on their Subscription page.
PAY_BKASH=
PAY_NAGAD=
PAY_UPAY=
PAY_ROCKET=
PAY_BANK=
INVOICE_ISSUER=Dawai

# The operator login created by `seed/run.js platform-admin`.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

SENTRY_DSN=
